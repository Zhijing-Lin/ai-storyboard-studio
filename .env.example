# Copy to .env.local (never commit .env.local) and fill in your key.

# Required — server-side only. Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Optional — model used for both generation steps (default: gpt-5.4-mini).
OPENAI_MODEL=gpt-5.4-mini

# Optional — reasoning effort for reasoning models: none | minimal | low | medium | high.
# Defaults to "low" for the default model. Leave empty for non-reasoning models (e.g. gpt-4.1-mini).
OPENAI_REASONING_EFFORT=low

# Optional — max AI requests per server per day (cost safeguard). Default: 60.
AI_DAILY_REQUEST_LIMIT=60

# Leave false. The AI routes refuse to run on Vercel unless this is true,
# because they have no authentication. Add auth before enabling.
ALLOW_PUBLIC_AI_ENDPOINTS=false
